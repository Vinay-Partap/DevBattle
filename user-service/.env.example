# ============================================================
# DevBattle — User Service Environment Configuration
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=4001
APP_NAME=devbattle-user-service
API_PREFIX=/api/v1
# Comma separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- PostgreSQL (Supabase) ----
# Example (Supabase): postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Root docker-compose exposes the User DB on host port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/devbattle_user

# ---- JWT Verification (Auth Service is the source of truth) ----
# Shared secret used by the Auth Service to sign tokens. This service ONLY verifies.
# For asymmetric (RS256) verification set JWT_PUBLIC_KEY (PEM) instead of JWT_SECRET.
JWT_ACCESS_SECRET=devbattle-shared-jwt-secret
JWT_REFRESH_SECRET=refresh-secret-change-me
JWT_PUBLIC_KEY=
JWT_ISSUER=devbattle-auth-service
JWT_AUDIENCE=devbattle-client

# ---- Internal service-to-service security ----
# Token sent by the Auth Service / platform gateway when provisioning a user profile.
INTERNAL_API_KEY=internal-service-token-change-me
AUTH_SERVICE_URL=http://localhost:4000

# ---- Avatar storage ----
# Leave SUPABASE_* empty to fall back to local disk storage under ./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars
AVATAR_MAX_SIZE_MB=5
AVATAR_LOCAL_DIR=uploads

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Logging ----
LOG_LEVEL=info
