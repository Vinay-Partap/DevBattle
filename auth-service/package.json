{
  "name": "devbattle-auth-service",
  "version": "1.0.0",
  "description": "Production-ready Authentication Microservice for the DevBattle platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/database/migrate.js",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/database/seed.js",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --forceExit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration --forceExit --detectOpenHandles",
    "swagger": "node src/swagger/generate.js"
  },
  "keywords": [
    "authentication",
    "microservice",
    "jwt",
    "express",
    "postgresql",
    "drizzle"
  ],
  "author": "DevBattle",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.15",
    "postgres": "^3.4.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "drizzle-kit": "^0.24.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
