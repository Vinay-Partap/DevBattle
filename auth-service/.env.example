# ===========================================
# DevBattle Auth Service - Environment Config
# ===========================================

# ---------- Application ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---------- Database (PostgreSQL / Supabase) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devbattle_auth

# ---------- JWT ----------
JWT_ACCESS_SECRET=devbattle-shared-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# ---------- Cookies ----------
COOKIE_SECRET=your-cookie-secret-change-in-production
# Leave empty for localhost/proxied previews; set a parent domain only in production.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=DevBattle
SMTP_FROM_EMAIL=noreply@devbattle.com

# ---------- Application URLs ----------
CLIENT_URL=http://localhost:5173
RESET_PASSWORD_URL=http://localhost:5173/reset-password
VERIFY_EMAIL_URL=http://localhost:5173/email-verification

# ---------- Service Integration ----------
USER_SERVICE_URL=http://localhost:4001
INTERNAL_API_KEY=internal-service-token-change-me

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Logging ----------
LOG_LEVEL=debug
