# ============================================================
# DevBattle — Question Service Environment Configuration
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=4002
APP_NAME=devbattle-question-service
API_PREFIX=/api/v1
# Comma separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- PostgreSQL (Supabase) ----
# Example (Supabase): postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devbattle

# ---- JWT Verification (Auth Service is the source of truth) ----
# Shared secret used by the Auth Service to sign tokens. This service ONLY verifies.
# For asymmetric (RS256) verification set JWT_PUBLIC_KEY (PEM) instead of JWT_SECRET.
JWT_ACCESS_SECRET=devbattle-shared-jwt-secret
JWT_SECRET=devbattle-shared-jwt-secret
JWT_PUBLIC_KEY=
JWT_ISSUER=devbattle-auth-service
JWT_AUDIENCE=devbattle-client

# ---- Internal service-to-service security ----
# Token sent by the Judge/Submission Service and platform gateway when reading
# full question payloads (including hidden test cases) or recording attempt stats.
INTERNAL_API_KEY=internal-service-token-change-me

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Logging ----
LOG_LEVEL=info
